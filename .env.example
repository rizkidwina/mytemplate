
# APPLICATION
APP_NAME=FastAPI Backend Starter
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# FRONTEND
FRONTEND_PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://api:8000

# BACKEND
BACKEND_PORT=8000
BACKEND_WORKERS=1
CORS_ORIGINS=http://localhost:3000

# BETTER AUTH
BETTER_AUTH_SECRET=generate_a_secure_secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# POSTGRESQL
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
POSTGRES_DB=app_db
POSTGRES_EXTERNAL_PORT=5433

# DATABASE CONNECTION
DATABASE_URL=postgresql+psycopg://app:change_me@db:5432/app_db
AUTH_DATABASE_URL=postgresql://app:change_me@db:5432/app_db

# SECURITY
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# TIMEZONE
TZ=Asia/Jakarta
